@article{jeon2026isa,
  abbr        = {ISA Trans.},
  title       = {Novel Clustering Approach for Multi-Zone VRF Systems Using Q-Learning},
  author      = {Jeon, Chanwook and others},
  journal     = {ISA Transactions},
  year        = {2026},
  month       = {8},
  note        = {제1저자 · 심사 중 (Under Review)},
  selected    = {true},
  sum_problem = {실제 건물 환경에서는 운전 조건 변화와 외란 때문에 단일 온도 데이터만으로는 실내기 고유 특성을 안정적으로 추출하기 어렵다.},
  sum_method  = {Q-테이블을 실내기별 제어-응답 특성 표현으로 재해석하고, 온도와 습도를 결합한 다변량 상태 표현을 정의한 뒤, 신규 운전 데이터 기반의 점진적 갱신 구조를 설계했다.},
  sum_effect  = {실제 건물 VRF 제어보드에 탑재해 실증했으며, 짧은 운전 데이터만으로 동작하고 신규 데이터로 계속 갱신할 수 있음을 보였다.}
}

